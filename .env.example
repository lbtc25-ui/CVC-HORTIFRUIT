# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
#   Supabase → Project Settings → Data API  (URL)
#   Supabase → Project Settings → API Keys  (chave anon / publishable)
#
# .env.local não vai para o Git (coberto por "*.local" no .gitignore).
# No Vercel, cadastre as duas variáveis em Settings → Environment Variables.
#
# Atenção: tudo que começa com VITE_ é embutido no JavaScript enviado ao
# navegador. Nunca coloque aqui a service_role key nem senhas do banco.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Endereço público do sistema, usado nos links enviados aos clientes
# (/pedido/...) e nos avisos do celular. Sem isto vale o endereço aberto no
# navegador (o *.vercel.app, se for por ele que se entra). Sem barra no fim.
VITE_APP_URL=https://seu-dominio.com.br

# Emissão de NF-e (Spedy) — usadas só pela função em api/spedy.js, nunca
# pelo navegador. Por isso SEM o prefixo VITE_. Cadastre-as em Vercel →
# Settings → Environment Variables (não em .env.local, que não roda com
# `npm run dev` — veja "Emitir NF-e" no README; use `vercel dev` local).
#
# É uma API só (https://api.spedy.com.br/v1) — não é preciso trocar de host
# pra testar. Quem decide se a nota vai pra SEFAZ de homologação (teste) ou
# de produção é o campo "Ambiente" na configuração da empresa, dentro do
# próprio painel do Spedy (app.spedy.com.br → Configurações → NF-e →
# Ambiente). Deixe em "Homologação" até validar a emissão de ponta a ponta;
# só troque pra "Produção" quando for emitir de verdade.
# CVC emite por duas contas Spedy: a própria (SPEDY_API_KEY) e a da Carvalho
# Cruz (SPEDY_API_KEY_CARVALHO), para os produtos ainda faturados por ela.
SPEDY_API_KEY=chave-spedy-da-cvc
SPEDY_API_KEY_CARVALHO=chave-spedy-da-carvalho-cruz
SPEDY_BASE_URL=https://api.spedy.com.br/v1

# --- Omie: integração abandonada (trocada pelo Spedy — mais barato, sem
# OAuth pra manter vivo, sandbox de testes de verdade). api/omie.js e
# src/lib/omie.js ficam no repo só de referência; nada abaixo é usado.
OMIE_APP_KEY=o-app-key-do-seu-aplicativo-omie
OMIE_APP_SECRET=o-app-secret-do-seu-aplicativo-omie
VITE_EMITENTE_UF=SE
VITE_OMIE_CODIGO_CATEGORIA=1.01.01
VITE_OMIE_CODIGO_CONTA_CORRENTE=3543874457

# Comprovantes de pagamento enviados pelo Atalho do iPhone — usados só por
# api/comprovante.js, SEM prefixo VITE_ (cadastre no Vercel, não aqui).
#   COMPROVANTE_TOKEN          uma senha longa e aleatória; vai no Atalho
#   SUPABASE_SERVICE_ROLE_KEY  Supabase → Project Settings → API Keys (service_role)
#   SUPABASE_URL               opcional: sem ela vale a VITE_SUPABASE_URL
COMPROVANTE_TOKEN=gere-uma-senha-longa-e-aleatoria
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-do-supabase
